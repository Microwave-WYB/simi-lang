set shell := ["bash", "-cu"]

component := source_directory()

default: test

dependencies:
    cd "{{component}}" && npm ci

install: dependencies

# Rebuild the bundled parser from the shared grammar; TextMate sources are maintained directly.
generate: dependencies
    cd "{{component}}" && npm run generate:parser

test: dependencies
    cd "{{component}}" && npm test

# Source-development packages use an external server and must not retain a staged release binary.
package: dependencies
    rm -rf "{{component}}/bin"
    cd "{{component}}" && npm run package

# Release automation stages the matching native server and packages the validated committed parser.
package-bundled: dependencies
    test -f "{{component}}/bin/simi" || test -f "{{component}}/bin/simi.exe"
    cd "{{component}}" && npm run package:release

# Build, bundle, and install the language server from the current checkout.
install-local: dependencies
    #!/usr/bin/env bash
    set -euo pipefail
    component="{{component}}"
    repository="$(cd "$component/../.." && pwd)"
    executable=simi
    case "$(uname -s)" in
      MINGW*|MSYS*|CYGWIN*) executable=simi.exe ;;
    esac
    CARGO_TARGET_DIR="$repository/target" cargo build --manifest-path "$repository/Cargo.toml" --bin simi
    rm -rf "$component/bin"
    mkdir -p "$component/bin"
    cp "$repository/target/debug/$executable" "$component/bin/$executable"
    chmod +x "$component/bin/$executable"
    cd "$component"
    npm run package
    version="$(node -p 'require("./package.json").version')"
    vsix="simi-language-${version}.vsix"
    test -f "$vsix"
    code --install-extension "$vsix" --force

# Marketplace publication is intentionally guarded and is never part of another recipe.
publish: test
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${CONFIRM_PUBLISH:-}" != "1" ]]; then
      echo "Refusing to publish. Re-run with CONFIRM_PUBLISH=1 and VSCE_PAT set." >&2
      exit 2
    fi
    : "${VSCE_PAT:?VSCE_PAT must contain a Visual Studio Marketplace token}"
    cd "{{component}}"
    npm run publish
