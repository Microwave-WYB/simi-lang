-- Classify values and exercise Simi's editing grammar.
fn classify(value, limit) do
    let threshold = 0x_ff + 0b_1010 + 1_000.25 + 1.5_0e+2
    let message = "line\nvalue"
    if value >= threshold and not false then
        "large"
    elseif value == nil or value < limit then
        value ?> tap inspect()
    else
        case [value, message] of
            [head, ..tail] when true =>
                { result = head, rest = tail }
            _ =>
                "small"
        end
    end
end

fn declared_effect(
    xs: [..integer],
    pair: [integer, string],
) -> nil do nil end

let mapper = fn(item) do item * 2 end
let spread_values = [0, ..[1, 2], 3]
let iter = require("std/iter")
let mapped = iter.map(list.iter([1, 2])) <| mapper
let handled = do
    let attempted = { error = "bad" }
    raise attempted
catch of
    { error = reason } =>
        reason
end
let optional = do mapped? end
let final = iter.fold_while(iter.repeat_with(fn() do 1 end), 0, fn(state, _) do
    if state > 1 then iter.break(state) else iter.continue(state + 1) end
end)
let ranged_pairs = iter.enumerate(iter.zip_longest(iter.range(0, 2), iter.once(final), nil))
let sliced_pairs = iter.take(iter.drop(ranged_pairs, 0), 2)
let bad_escape = "\q"
let concatenated = "Simi" <> " language"
let integer_check = type(threshold) == "integer"
let function_check = type(mapper) == "function"
let is = integer_check
let piped = mapped |> list.length()
fn identity<'a: | integer | string>(value: 'a) -> 'a ! never do value end
let typed_mapper: fn<'a: any>(input: | integer | string) -> 'a ! string = nil
let generic_lambda = fn<'a: any>(value: 'a) -> 'a ! string do value end
let raised = 1
let no_raise = raised
fn nested<'a: wrapper<integer>>(value: 'a) -> 'a ! never do value end
let typed_no_raise: fn() -> nil ! never = nil
let literal_raise: fn() -> nil ! "oops" = nil
let parsed = string.to_number("42")
let distinct = 1 != 2

requires {
    local = {path = "packages/local"}
}
