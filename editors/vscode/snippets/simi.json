{
  "Standalone block": {
    "prefix": "do",
    "body": [
      "do",
      "    $0",
      "end"
    ],
    "description": "Create a standalone value-producing block"
  },
  "Named function": {
    "prefix": "fn",
    "body": [
      "fn $1($2) do",
      "    $0",
      "end"
    ],
    "description": "Declare a named function"
  },
  "Anonymous function": {
    "prefix": "fnexpr",
    "body": [
      "fn($1) do",
      "    $0",
      "end"
    ],
    "description": "Create an anonymous function expression"
  },
  "If expression": {
    "prefix": "if",
    "body": [
      "if $1 then",
      "    $0",
      "end"
    ],
    "description": "Create an if expression"
  },
  "If else expression": {
    "prefix": "ifelse",
    "body": [
      "if $1 then",
      "    $2",
      "else",
      "    $0",
      "end"
    ],
    "description": "Create an if/else expression"
  },
  "Functional loop": {
    "prefix": "loop",
    "body": [
      "loop $1 = $2 do",
      "    $0",
      "end"
    ],
    "description": "Create a state-threading functional loop"
  },
  "Case expression": {
    "prefix": "case",
    "body": [
      "case $1",
      "of $2 do",
      "    $3",
      "of _ do",
      "    $0",
      "end"
    ],
    "description": "Create a case expression with one final end"
  },
  "Try catch expression": {
    "prefix": "try",
    "body": [
      "try",
      "    $1",
      "catch $2 do",
      "    $0",
      "end"
    ],
    "description": "Create a try/catch expression with one final end"
  }
}
