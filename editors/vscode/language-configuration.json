{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "(?:\\b(?:do|then|else|catch)\\s*(?:--.*)?$|^\\s*(?:fn|of)\\b(?!.*\\bend\\s*(?:--.*)?$).*$)",
    "decreaseIndentPattern": "^\\s*(?:end|elseif\\b|else\\b|of\\b|catch\\b)",
    "indentNextLinePattern": "^\\s*case\\b(?:[^-]|-[^-])*(?:[^d\\s]|[^n\\s]d|[^e\\s]nd)\\s*(?:--.*)?$"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*--\\s*#?region\\b",
      "end": "^\\s*--\\s*#?endregion\\b"
    }
  }
}
