{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^(?!\\s*--)(?:.*\\b(?:do|then|else)\\s*(?:--.*)?|\\s*(?:fn\\b(?!.*\\bend\\s*(?:--.*)?$).*|case\\b.*\\bof\\s*|catch\\s+of\\s*|(?!.*--.*=>).*=>\\s*)(?:--.*)?)$",
    "decreaseIndentPattern": "^\\s*(?:end|elseif\\b|else\\b|catch\\b)",
    "indentNextLinePattern": "^\\s*(?:case\\b.*\\bof|catch\\s+of|(?!.*--.*=>).*=>)\\s*(?:--.*)?$"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*--\\s*#?region\\b",
      "end": "^\\s*--\\s*#?endregion\\b"
    }
  }
}
