-- Exercises the syntax used by the Zed queries.
alias option<'a> = 'a | nil
alias pair<'a, 'b> = ['a, 'b]

let typed_value: option<string> = nil
let typed_record: { name: string, .. } = { name = "Simi" }

fn typed_identity<'a: | integer | string>(value: 'a) -> 'a ! never do
    value
end

let typed_callback: <'a: any> fn(input: | integer | string) -> 'a ! string = nil
let typed_lambda = fn<'a: any>(value: 'a) -> 'a ! string do value end

fn declared_effect(
    xs: [..integer],
    pair: [integer, string],
) -> nil do nil end


let iter = require("std/iter")

fn classify(value) do
    case value of
        [first, ..rest] when first >= 1 =>
            { kind = "positive\n", value = first, rest = rest }
        { error = message, ..details } =>
            { kind = "error", message = message, details = details }
        0 =>
            do
                let kind = "zero"
                { kind = kind, value = value }
            end
        _ =>
            nil
    end
end

let transform = fn(value) do
    if value == 0 then
        false
    elseif value != 1 and not false then
        true
    else
        value * 2 + 1 // 2 % 3
    end
end

let values = [1, 2.5e1, 0x_ff, 0b_1010, 1_000.25, 3]
let result = values ?> list.iter() |> iter.map() <| transform
let optional = do result? end
let concatenated = "Simi" <> " language"
let has_runtime_label = type(result) == "list"
let is = has_runtime_label
let final = iter.fold_while(iter.repeat_with(fn() do 1 end), 0, fn(state, _) do
    if state < 2 or state <= -1 then iter.continue(state + 1)
    else iter.break(state) end
end)
let ranged_pairs = iter.zip_longest(iter.range(0, 2), iter.once(final), nil)
let indexed_pairs = iter.enumerate(iter.take(iter.drop(ranged_pairs, 0), 2))

do
    let error = { error = "example" }
    raise error
catch of
    { error = message } when message != nil =>
        classify([final, indexed_pairs])
    "retry" =>
        do
            let recovered = classify([final])
            recovered
        end
    _ =>
        nil
end
