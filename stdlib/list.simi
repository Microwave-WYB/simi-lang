---- Mutable list operations and higher-order queries.

alias IndexError = {
    error: "index_out_of_bounds",
    index: integer,
    length: integer,
    ..
}
alias Step<'a> =
    | { done: true, .. }
    | { done: false, value: 'a, .. }
alias Iterator<'a> = fn() -> Step<'a> ! never

--- Return the number of visible elements in a list.
let length: fn(xs: [..'a]) -> integer ! never = host.length

--- Create an independent shallow copy of a list.
let copy: fn(xs: [..'a]) -> [..'a] ! never = host.copy

--- Return the value at an index, or nil when it is out of range.
let get: fn(xs: [..'a], index: integer) -> 'a | nil ! never = host.get

--- Append a value to a list.
let append: fn(xs: [..'a], value: 'b) -> nil ! never = host.append

--- Append every value from one list to another.
let extend: fn(xs: [..'a], values: [..'b]) -> nil ! never = host.extend

--- Replace the value at an existing index.
let set: fn(xs: [..'a], index: integer, value: 'b) -> nil ! IndexError = host.set

--- Insert a value at an existing position.
let insert: fn(xs: [..'a], index: integer, value: 'b) -> nil ! IndexError = host.insert

--- Remove and return the value at an index.
let remove: fn(xs: [..'a], index: integer) -> 'a ! IndexError = host.remove

--- Remove and return the final value, or raise when the list is empty.
let pop: fn(xs: [..'a]) -> 'a ! IndexError = host.pop

--- Create a shallow copy of a visible range.
let slice: fn(xs: [..'a], start: integer, stop: integer) -> [..'a] ! never = host.slice

--- Return whether a list contains a value.
let contains: fn(xs: [..'a], value: 'a) -> boolean ! never = host.contains

--- Reverse a list in place.
let reverse: fn(xs: [..'a]) -> nil ! never = host.reverse

--- Create a lazy iterator over an O(1) copy-on-write snapshot.
fn iter<'a>(xs: [..'a]) -> Iterator<'a> ! never do
    let snapshot = host.iter(xs)
    let length = host.length(snapshot)
    let state: {index: integer} = {index = 0}
    fn() do
        if state.index >= length then {done = true}
        else
            let value = snapshot[state.index]
            state.index = state.index + 1
            {done = false, value = value}
        end
    end
end

{
    length = length,
    copy = copy,
    get = get,
    append = append,
    extend = extend,
    set = set,
    insert = insert,
    remove = remove,
    pop = pop,
    slice = slice,
    contains = contains,
    reverse = reverse,
    iter = iter,
}
