---- UTF-8 encoding and strict decoding.

--- Encode a string into its UTF-8 byte representation.
let encode: fn(text: string) -> bytes ! never = host.encode

--- Strictly decode UTF-8 bytes into a string, or nil when malformed.
let decode: fn(data: bytes) -> string | nil ! never = host.decode

{
    encode = encode,
    decode = decode,
}
