---- Operations for mutable insertion-ordered maps.

alias Entry = {
    key: string | integer | float | boolean,
    value: any,
    ..
}
alias Step =
    | { done: true, .. }
    | { done: false, value: Entry, .. }
alias Iterator = fn() -> Step ! never

--- Return the number of entries in a map.
let length: fn(entries: { .. }) -> integer ! never = host.length

--- Create an independent shallow copy of a map.
let copy: fn(entries: { .. }) -> { .. } ! never = host.copy

--- Return whether a map contains a key.
let has: fn(entries: { .. }, key: string | integer | float | boolean) -> boolean ! never = host.has

--- Create an insertion-ordered iterator over map entries.
fn iter(entries: { .. }) -> Iterator ! never do
    let snapshot = host.iter(entries)
    let state: {index: integer} = {index = 0}
    fn() do
        if state.index >= host.snapshot_length(snapshot) then {done = true}
        else
            let value: Entry = snapshot[state.index]
            state.index = state.index + 1
            {done = false, value = value}
        end
    end
end

--- Remove every entry from a map.
let clear: fn(entries: { .. }) -> nil ! never = host.clear

{length = length, copy = copy, has = has, iter = iter, clear = clear}
