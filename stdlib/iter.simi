---- Lazy, single-pass iterator operations.

alias Step<'a> =
    | { done: true, .. }
    | { done: false, value: 'a, .. }
alias Iterator<'a, 'e> = () -> Step<'a> raises 'e
alias Continue<'next> = { control: "continue", value: 'next, .. }
alias Break<'result> = { control: "break", value: 'result, .. }
alias Control<'next, 'result> =
    | Continue<'next>
    | Break<'result>

fn from<'a, 'e>(next_fn: Iterator<'a, 'e>) -> Iterator<'a, 'e> noraise do
    let exhausted = false
    fn() do
        if exhausted then { done = true }
        else
            let step = next_fn()
            if step.done then
                exhausted = true
                { done = true }
            else
                { done = false, value = step.value }
            end
        end
    end
end

fn next<'a, 'e>(iterator: Iterator<'a, 'e>) -> Step<'a> raises 'e do iterator() end

fn map<'a, 'b, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    transform: 'a -> 'b raises 'f,
) -> Iterator<'b, 'e | 'f> noraise do
    fn() do
        let step = iterator()
        if step.done then step else { done = false, value = transform(step.value) } end
    end
end

fn filter<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    predicate: 'a -> boolean raises 'f,
) -> Iterator<'a, 'e | 'f> noraise do
    fn() -> Step<'a> raises 'e | 'f do host.filter_next(iterator, predicate) end
end

fn to_list<'a, 'e>(iterator: Iterator<'a, 'e>) -> [..'a] raises 'e do
    host.to_list(iterator)
end

fn fold<'state, 'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    initial: 'state,
    reducer: ('state, 'a) -> 'state raises 'f,
) -> 'state raises 'e | 'f do
    host.fold(iterator, initial, reducer)
end

fn find<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    predicate: 'a -> boolean raises 'f,
) -> 'a | nil raises 'e | 'f do
    host.find(iterator, predicate)
end

fn find_index<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    predicate: 'a -> boolean raises 'f,
) -> integer | nil raises 'e | 'f do
    host.find_index(iterator, predicate)
end

fn contains<'a, 'e>(iterator: Iterator<'a, 'e>, needle: 'a) -> boolean raises 'e do
    host.contains(iterator, needle)
end

fn any<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    predicate: 'a -> boolean raises 'f,
) -> boolean raises 'e | 'f do
    host.any(iterator, predicate)
end

fn all<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    predicate: 'a -> boolean raises 'f,
) -> boolean raises 'e | 'f do
    host.all(iterator, predicate)
end

fn each<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    callback: 'a -> any raises 'f,
) -> nil raises 'e | 'f do
    host.each(iterator, callback)
end

fn count<'a, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    predicate: 'a -> boolean raises 'f,
) -> integer raises 'e | 'f do
    host.count(iterator, predicate)
end

fn break_control<'result>(value: 'result) -> Break<'result> noraise do
    { control = "break", value = value }
end

fn continue_control<'next>(value: 'next) -> Continue<'next> noraise do
    { control = "continue", value = value }
end

fn each_while<'a, 'ignored, 'result, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    callback: 'a -> Control<'ignored, 'result> raises 'f,
) -> 'result | nil raises 'e | 'f do
    host.each_while(iterator, callback)
end

fn fold_while<'state, 'a, 'result, 'e, 'f>(
    iterator: Iterator<'a, 'e>,
    initial: 'state,
    step: ('state, 'a) -> Control<'state, 'result> raises 'f,
) -> 'state | 'result raises 'e | 'f do
    host.fold_while(iterator, initial, step)
end

fn repeat_with<'a, 'e>(producer: () -> 'a raises 'e) -> Iterator<'a, 'e> noraise do
    fn() -> Step<'a> raises 'e do
        { done = false, value = host.repeat_next(producer) }
    end
end

{
    from = from, next = next, map = map, filter = filter,
    to_list = to_list, fold = fold, find = find, find_index = find_index,
    contains = contains, any = any, all = all, each = each, count = count,
    ["break"] = break_control, ["continue"] = continue_control,
    each_while = each_while, fold_while = fold_while, repeat_with = repeat_with,
}
