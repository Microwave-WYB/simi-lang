---- A single-file Lisp interpreter implemented in Simi.
----
---- It demonstrates recursive closed types, parsing, lexical environments,
---- closures, special forms, and meaningful raised interpreter errors.

alias Name = string
alias Token = string
alias Tokens = [..Token]
alias MaybeValue = Value | nil

type Expr =
    | {kind: "integer", value: integer}
    | {kind: "boolean", value: boolean}
    | {kind: "symbol", name: Name}
    | {kind: "list", items: [..Expr]}

type Value =
    | integer
    | boolean
    | {kind: "symbol", name: Name}
    | [..Value]
    | Closure
    | Builtin

type Closure = {
    kind: "closure",
    parameters: [..Name],
    body: Expr,
    environment: Environment,
}

type Builtin = {
    kind: "builtin",
    name: Name,
    operation:
        | "add"
        | "subtract"
        | "multiply"
        | "divide"
        | "equals"
        | "negate"
        | "cons"
        | "car"
        | "cdr"
        | "empty",
}

type Environment = {
    values: {[Name]: Value},
    parent: Environment | nil,
}

---- AST constructors return only the closed Expr variants.

fn integer_expression(value: integer) -> Expr
    {kind = "integer", value = value}

fn boolean_expression(value: boolean) -> Expr
    {kind = "boolean", value = value}

fn symbol_expression(name: Name) -> Expr
    {kind = "symbol", name = name}

fn list_expression(items: [..Expr]) -> Expr
    {kind = "list", items = items}

---- Reader
----
---- ParseResult carries the immutable next-token cursor through recursive parsing.

type ParseResult = {expression: Expr, next: integer}

fn is_space(character: string) -> boolean
    character == " " or character == "\n" or character == "\t" or character == "\r"

fn scan(source: string, index: integer, tokens: Tokens) -> Tokens
    if index >= string.length(source) then
        tokens
    else
        let character = string.slice(source, index, index + 1)
        case character of
            _ when is_space(character) => scan(source, index + 1, tokens)
            "(" => do
                list.append(tokens, character)
                scan(source, index + 1, tokens)
            end
            ")" => do
                list.append(tokens, character)
                scan(source, index + 1, tokens)
            end
            _ => scan_word(source, index, index, tokens)
        end
    end

fn scan_word(source: string, index: integer, start: integer, tokens: Tokens) -> Tokens
    if index >= string.length(source) then
        list.append(tokens, string.slice(source, start, index))
        tokens
    else
        let character = string.slice(source, index, index + 1)
        case character of
            _ when is_space(character) => do
                list.append(tokens, string.slice(source, start, index))
                scan(source, index, tokens)
            end
            "(" => do
                list.append(tokens, string.slice(source, start, index))
                scan(source, index, tokens)
            end
            ")" => do
                list.append(tokens, string.slice(source, start, index))
                scan(source, index, tokens)
            end
            _ => scan_word(source, index + 1, start, tokens)
        end
    end

fn tokenize(source: string) -> Tokens
    scan(source, 0, [])

fn token_at(tokens: Tokens, index: integer) -> Token | nil
    if index >= list.length(tokens) then nil else tokens[index] end

fn take(tokens: Tokens, index: integer) -> Token
    case token_at(tokens, index) of
        nil => raise {error = "lisp_parse_error", message = "unexpected end of input"}
        token => token
    end

fn parse_list(tokens: Tokens, index: integer) -> ParseResult do
    let items: [..Expr] = []
    parse_list_items(tokens, index + 1, items)
end

fn parse_list_items(tokens: Tokens, index: integer, items: [..Expr]) -> ParseResult
    case token_at(tokens, index) of
        nil => raise {error = "lisp_parse_error", message = "missing closing parenthesis"}
        ")" => {expression = list_expression(items), next = index + 1}
        _ => do
            let parsed = parse_expression(tokens, index)
            list.append(items, parsed.expression)
            parse_list_items(tokens, parsed.next, items)
        end
    end

fn parse_atom(token: Token) -> Expr
    case token of
        "#t" => boolean_expression(true)
        "#f" => boolean_expression(false)
        _ => do
            let number = string.to_number(token)
            if type(number) == "integer" then integer_expression(number) else symbol_expression(token) end
        end
    end

fn parse_expression(tokens: Tokens, index: integer) -> ParseResult
    case take(tokens, index) of
        "(" => parse_list(tokens, index)
        ")" => raise {error = "lisp_parse_error", message = "unexpected closing parenthesis"}
        token => {expression = parse_atom(token), next = index + 1}
    end

fn read(source: string) -> Expr do
    let tokens = tokenize(source)
    let parsed = parse_expression(tokens, 0)
    if parsed.next == list.length(tokens) then
        parsed.expression
    else
        raise {error = "lisp_parse_error", message = "expected one complete expression"}
    end
end

---- Evaluator

fn environment(parent: Environment | nil) -> Environment do
    let env: Environment = {values = {}, parent = parent}
    env
end

fn lookup(env: Environment, name: Name) -> Value
    case env.values[name] of
        nil =>
            case env.parent of
                nil => raise {error = "lisp_unbound_symbol", symbol = name}
                parent => lookup(parent, name)
            end
        value => value
    end

fn expect_arity(values: [..Value], expected: integer, form: string) -> nil
    if list.length(values) == expected then
        nil
    else
        raise {
            error = "lisp_arity_error",
            form = form,
            expected = expected,
            actual = list.length(values),
        }
    end

fn expect_symbol(expression: Expr, form: string) -> Name
    case expression of
        {kind = "symbol", name = name} => name
        _ => raise {error = "lisp_invalid_form", form = form, message = "expected a symbol"}
    end

fn expect_value(value: MaybeValue, form: string) -> Value
    case value of
        nil => raise {error = "lisp_type_error", form = form, expected = "value", actual = "nil"}
        value => value
    end

fn expect_list(value: MaybeValue, form: string) -> [..Value]
    if type(value) == "list" then
        value
    else
        raise {error = "lisp_type_error", form = form, expected = "list", actual = type(value)}
    end

fn expect_integer(value: MaybeValue, form: string) -> integer
    if type(value) == "integer" then
        value
    else
        raise {error = "lisp_type_error", form = form, expected = "integer", actual = type(value)}
    end

fn expect_boolean(value: MaybeValue, form: string) -> boolean
    if type(value) == "boolean" then
        value
    else
        raise {error = "lisp_type_error", form = form, expected = "boolean", actual = type(value)}
    end

fn datum(expression: Expr) -> Value
    case expression of
        {kind = "integer", value = value} => value
        {kind = "boolean", value = value} => value
        {kind = "symbol", name = name} => {kind = "symbol", name = name}
        {kind = "list", items = items} => datum_list(items)
    end

fn datum_list(expressions: [..Expr]) -> [..Value] do
    let values: [..Value] = []
    datum_items(expressions, 0, values)
end

fn datum_items(expressions: [..Expr], index: integer, values: [..Value]) -> [..Value]
    if index == list.length(expressions) then
        values
    else
        list.append(values, datum(expressions[index]))
        datum_items(expressions, index + 1, values)
    end

fn parameters(expression: Expr) -> [..Name]
    case expression of
        {kind = "list", items = items} => parameter_items(items, 0, [])
        _ => raise {error = "lisp_invalid_form", form = "lambda", message = "expected a parameter list"}
    end

fn parameter_items(items: [..Expr], index: integer, names: [..Name]) -> [..Name]
    if index == list.length(items) then
        names
    else
        list.append(names, expect_symbol(items[index], "lambda"))
        parameter_items(items, index + 1, names)
    end

fn evaluate(expression: Expr, env: Environment) -> Value
    case expression of
        {kind = "integer", value = value} => value
        {kind = "boolean", value = value} => value
        {kind = "symbol", name = name} => lookup(env, name)
        {kind = "list", items = items} => evaluate_list(items, env)
    end

fn is_named(expression: Expr, name: Name) -> boolean
    case expression of
        {kind = "symbol", name = actual} => actual == name
        _ => false
    end

fn closure(parameters: [..Name], body: Expr, captured: Environment) -> Closure
    {kind = "closure", parameters = parameters, body = body, environment = captured}

fn evaluate_list(items: [..Expr], env: Environment) -> Value
    if list.length(items) == 0 then
        raise {error = "lisp_empty_list", form = "application"}
    elseif is_named(items[0], "quote") then do
        expect_arity_expr(items, 2, "quote")
        datum(items[1])
    end
    elseif is_named(items[0], "if") then do
        expect_arity_expr(items, 4, "if")
        if expect_boolean(evaluate(items[1], env), "if") then
            evaluate(items[2], env)
        else
            evaluate(items[3], env)
        end
    end
    elseif is_named(items[0], "let") then do
        expect_arity_expr(items, 4, "let")
        let name = expect_symbol(items[1], "let")
        let value = evaluate(items[2], env)
        let child = environment(env)
        child.values[name] = value
        evaluate(items[3], child)
    end
    elseif is_named(items[0], "define") then do
        expect_arity_expr(items, 3, "define")
        env.values[expect_symbol(items[1], "define")] = evaluate(items[2], env)
    end
    elseif is_named(items[0], "lambda") then do
        expect_arity_expr(items, 3, "lambda")
        closure(parameters(items[1]), items[2], env)
    end
    elseif is_named(items[0], "and") then
        evaluate_and(items, 1, env)
    elseif is_named(items[0], "or") then
        evaluate_or(items, 1, env)
    else
        apply(evaluate(items[0], env), evaluate_arguments(items, 1, env))
    end

fn expect_arity_expr(values: [..Expr], expected: integer, form: string) -> nil
    if list.length(values) == expected then
        nil
    else
        raise {
            error = "lisp_arity_error",
            form = form,
            expected = expected,
            actual = list.length(values),
        }
    end

fn evaluate_arguments(items: [..Expr], index: integer, env: Environment) -> [..Value] do
    let values: [..Value] = []
    evaluate_argument_items(items, index, env, values)
end

fn evaluate_argument_items(items: [..Expr], index: integer, env: Environment, values: [..Value]) -> [..Value]
    if index == list.length(items) then
        values
    else
        list.append(values, evaluate(items[index], env))
        evaluate_argument_items(items, index + 1, env, values)
    end

fn evaluate_and(items: [..Expr], index: integer, env: Environment) -> boolean
    if index == list.length(items) then
        true
    else
        let value = expect_boolean(evaluate(items[index], env), "and")
        if value then evaluate_and(items, index + 1, env) else false end
    end

fn evaluate_or(items: [..Expr], index: integer, env: Environment) -> boolean
    if index == list.length(items) then
        false
    else
        let value = expect_boolean(evaluate(items[index], env), "or")
        if value then true else evaluate_or(items, index + 1, env) end
    end

fn bind(parameters: [..Name], arguments: [..Value], env: Environment, index: integer) -> nil
    if index == list.length(parameters) then
        nil
    else
        env.values[parameters[index]] = expect_value(arguments[index], "lambda")
        bind(parameters, arguments, env, index + 1)
    end

fn apply(value: MaybeValue, arguments: [..Value]) -> Value
    case value of
        {kind = "builtin", name = name, operation = operation} =>
            apply_builtin({kind = "builtin", name = name, operation = operation}, arguments)
        {kind = "closure", parameters = parameters, body = body, environment = captured} => do
            expect_arity(arguments, list.length(parameters), "lambda")
            let child = environment(captured)
            bind(parameters, arguments, child, 0)
            evaluate(body, child)
        end
        _ => raise {error = "lisp_not_callable", actual = type(value)}
    end

fn equal(left: MaybeValue, right: MaybeValue) -> boolean
    if type(left) == "integer" and type(right) == "integer" then
        left == right
    elseif type(left) == "boolean" and type(right) == "boolean" then
        left == right
    elseif type(left) == "list" and type(right) == "list" then
        list_equal(left, right, 0)
    else
        symbols_equal(left, right)
    end

fn symbols_equal(left: MaybeValue, right: MaybeValue) -> boolean
    case left of
        {kind = "symbol", name = left_name} =>
            case right of
                {kind = "symbol", name = right_name} => left_name == right_name
                _ => false
            end
        _ => false
    end

fn list_equal(left: [..Value], right: [..Value], index: integer) -> boolean
    if list.length(left) != list.length(right) then
        false
    elseif index == list.length(left) then
        true
    elseif equal(left[index], right[index]) then
        list_equal(left, right, index + 1)
    else
        false
    end

fn apply_builtin(builtin: Builtin, arguments: [..Value]) -> Value
    case builtin of
        {operation = "add", name = name, ..} => add(name, arguments)
        {operation = "subtract", name = name, ..} => subtract(name, arguments)
        {operation = "multiply", name = name, ..} => multiply(name, arguments)
        {operation = "divide", name = name, ..} => divide(name, arguments)
        {operation = "equals", name = name, ..} => equals(name, arguments)
        {operation = "negate", name = name, ..} => negate(name, arguments)
        {operation = "cons", name = name, ..} => cons(name, arguments)
        {operation = "car", name = name, ..} => car(name, arguments)
        {operation = "cdr", name = name, ..} => cdr(name, arguments)
        {operation = "empty", name = name, ..} => empty(name, arguments)
    end

fn add(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 2, name)
    expect_integer(arguments[0], name) + expect_integer(arguments[1], name)
end

fn subtract(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 2, name)
    expect_integer(arguments[0], name) - expect_integer(arguments[1], name)
end

fn multiply(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 2, name)
    expect_integer(arguments[0], name) * expect_integer(arguments[1], name)
end

fn divide(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 2, name)
    let divisor = expect_integer(arguments[1], name)
    if divisor == 0 then
        raise {error = "lisp_division_by_zero"}
    else
        expect_integer(arguments[0], name) // divisor
    end
end

fn equals(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 2, name)
    equal(arguments[0], arguments[1])
end

fn negate(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 1, name)
    not expect_boolean(arguments[0], name)
end

fn cons(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 2, name)
    let values: [..Value] = [expect_value(arguments[0], name)]
    list.extend(values, expect_list(arguments[1], name))
    values
end

fn car(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 1, name)
    let values = expect_list(arguments[0], name)
    if list.length(values) == 0 then
        raise {error = "lisp_empty_list", form = name}
    else
        values[0]
    end
end

fn cdr(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 1, name)
    let values = expect_list(arguments[0], name)
    if list.length(values) == 0 then
        raise {error = "lisp_empty_list", form = name}
    else
        list.slice(values, 1, list.length(values))
    end
end

fn empty(name: Name, arguments: [..Value]) -> Value do
    expect_arity(arguments, 0, name)
    let values: [..Value] = []
    values
end

fn install_builtins(env: Environment, builtins: [..Builtin], index: integer) -> nil
    if index == list.length(builtins) then
        nil
    else
        let builtin = builtins[index]
        env.values[builtin.name] = builtin
        install_builtins(env, builtins, index + 1)
    end

fn global_environment() -> Environment do
    let env = environment(nil)
    let builtins: [..Builtin] = [
        {kind = "builtin", name = "+", operation = "add"},
        {kind = "builtin", name = "-", operation = "subtract"},
        {kind = "builtin", name = "*", operation = "multiply"},
        {kind = "builtin", name = "/", operation = "divide"},
        {kind = "builtin", name = "=", operation = "equals"},
        {kind = "builtin", name = "not", operation = "negate"},
        {kind = "builtin", name = "cons", operation = "cons"},
        {kind = "builtin", name = "car", operation = "car"},
        {kind = "builtin", name = "cdr", operation = "cdr"},
        {kind = "builtin", name = "empty", operation = "empty"},
    ]
    install_builtins(env, builtins, 0)
    env
end

let env: Environment = global_environment()
let final_environment: Environment = env

{
    arithmetic = evaluate(read("(let square (lambda (value) (* value value)) (square 6))"), env),
    conditional = evaluate(read("(if #t 1 0)"), env),
    list_operations = evaluate(read("(= (car (cdr (cons 1 (cons 2 (empty))))) 2)"), env),
    quoted_symbols_equal = evaluate(read("(= (quote (one two)) (quote (one two)))"), env),
    boolean_logic = evaluate(read("(and #t (or #f (not #f)))"), env),
}
