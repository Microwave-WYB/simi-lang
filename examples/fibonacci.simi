let io = require("std/io")
let number = require("std/number")

fn fibonacci(n: integer) -> integer do
    let remaining = n
    let current = 0
    let next = 1

    loop
        if remaining == 0 then break current end
        let following = current + next
        current = next
        next = following
        remaining = remaining - 1
    end
end

let result = fibonacci(10)
io.println("fib(10) = " <> number.to_string(result))
